# File Workshop 环境变量模板。
# 复制为 .env 后填写本地值；本模板不得保存真实密码。
# 操作系统或部署平台设置的同名环境变量应优先于配置文件。

# -----------------------------------------------------------------------------
# 应用基础配置
# -----------------------------------------------------------------------------

# 当前运行环境，例如 development、test、production。
FILE_WORKSHOP_ENV=development

# 服务名称，会写入 PostgreSQL application_name 和结构化日志。
FILE_WORKSHOP_SERVICE_NAME=file-workshop-server

# -----------------------------------------------------------------------------
# HTTP 服务配置
# -----------------------------------------------------------------------------

# HTTP 监听地址和端口。
FILE_WORKSHOP_HTTP_HOST=127.0.0.1
FILE_WORKSHOP_HTTP_PORT=8080

# HTTP 请求头读取、完整请求读取、响应、空闲连接和优雅关闭超时。
FILE_WORKSHOP_HTTP_READ_HEADER_TIMEOUT=5s
FILE_WORKSHOP_HTTP_READ_TIMEOUT=15s
FILE_WORKSHOP_HTTP_WRITE_TIMEOUT=30s
FILE_WORKSHOP_HTTP_IDLE_TIMEOUT=60s
FILE_WORKSHOP_HTTP_SHUTDOWN_TIMEOUT=15s

# HTTP 请求头最大字节数，默认 1 MiB。
FILE_WORKSHOP_HTTP_MAX_HEADER_BYTES=1048576

# -----------------------------------------------------------------------------
# 身份认证与会话
# -----------------------------------------------------------------------------

# JWT 签名密钥必须是至少 32 个随机字节的标准 Base64 编码；各环境分别生成，严禁提交真实值。
FILE_WORKSHOP_AUTH_JWT_SECRET_BASE64=replace-with-base64-encoded-random-secret
FILE_WORKSHOP_AUTH_JWT_ISSUER=file-workshop
FILE_WORKSHOP_AUTH_JWT_AUDIENCE=file-workshop-api

# 访问令牌默认 15 分钟；刷新令牌与登录会话默认 7 天。
FILE_WORKSHOP_AUTH_ACCESS_TOKEN_TTL=15m
FILE_WORKSHOP_AUTH_REFRESH_TOKEN_TTL=168h

# 同一用户名在窗口内失败 5 次后，阻止后续登录 15 分钟。
FILE_WORKSHOP_AUTH_LOGIN_FAILURE_WINDOW=15m
FILE_WORKSHOP_AUTH_LOGIN_FAILURE_LIMIT=5
FILE_WORKSHOP_AUTH_LOGIN_LOCK_DURATION=15m

# 浏览器令牌仅通过 HttpOnly Cookie 传输；生产环境必须启用 Secure。
FILE_WORKSHOP_AUTH_ACCESS_COOKIE_NAME=file_workshop_access
FILE_WORKSHOP_AUTH_REFRESH_COOKIE_NAME=file_workshop_refresh
FILE_WORKSHOP_AUTH_COOKIE_SECURE=false
FILE_WORKSHOP_AUTH_COOKIE_SAME_SITE=lax
FILE_WORKSHOP_AUTH_COOKIE_DOMAIN=

# 允许发起带 Cookie 的状态变更认证请求的前端 Origin，多个值使用英文逗号分隔。
FILE_WORKSHOP_AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL 连接与连接池
# -----------------------------------------------------------------------------

# PostgreSQL 服务地址和端口。
FILE_WORKSHOP_POSTGRES_HOST=127.0.0.1
FILE_WORKSHOP_POSTGRES_PORT=5432

# 当前本地开发基线使用 root 用户和 postgres 数据库；测试、预发布和生产环境必须重新评审最小权限。
# 密码、数据库和业务 Schema 按实际环境填写。
FILE_WORKSHOP_POSTGRES_USER=root
FILE_WORKSHOP_POSTGRES_PASSWORD=change-me
FILE_WORKSHOP_POSTGRES_DATABASE=postgres
FILE_WORKSHOP_POSTGRES_SCHEMA=file_workshop

# 本地开发可以使用 disable；生产环境应启用并校验证书。
FILE_WORKSHOP_POSTGRES_SSL_MODE=disable

# 单个后端实例的连接池上下限。
FILE_WORKSHOP_POSTGRES_POOL_MAX_CONNS=10
FILE_WORKSHOP_POSTGRES_POOL_MIN_CONNS=1

# 连接寿命、随机抖动、空闲回收和健康检查周期。
FILE_WORKSHOP_POSTGRES_POOL_MAX_CONN_LIFETIME=1h
FILE_WORKSHOP_POSTGRES_POOL_MAX_CONN_LIFETIME_JITTER=10m
FILE_WORKSHOP_POSTGRES_POOL_MAX_CONN_IDLE_TIME=30m
FILE_WORKSHOP_POSTGRES_POOL_HEALTH_CHECK_PERIOD=1m

# 建连、启动 Ping、SQL 执行、锁等待和空闲事务超时。
FILE_WORKSHOP_POSTGRES_CONNECT_TIMEOUT=5s
FILE_WORKSHOP_POSTGRES_PING_TIMEOUT=5s
FILE_WORKSHOP_POSTGRES_STATEMENT_TIMEOUT=30s
FILE_WORKSHOP_POSTGRES_LOCK_TIMEOUT=5s
FILE_WORKSHOP_POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT=60s

# -----------------------------------------------------------------------------
# Redis 配置
# -----------------------------------------------------------------------------

# Redis 服务地址、端口、密码和逻辑数据库编号；无密码时保持空值。
FILE_WORKSHOP_REDIS_HOST=127.0.0.1
FILE_WORKSHOP_REDIS_PORT=6379
FILE_WORKSHOP_REDIS_PASSWORD=
FILE_WORKSHOP_REDIS_DATABASE=0

# Redis 建连、读取和写入超时。
FILE_WORKSHOP_REDIS_DIAL_TIMEOUT=5s
FILE_WORKSHOP_REDIS_READ_TIMEOUT=3s
FILE_WORKSHOP_REDIS_WRITE_TIMEOUT=3s

# Redis 健康检查超时。
FILE_WORKSHOP_REDIS_PING_TIMEOUT=3s

# Redis 客户端连接池大小、最小和最大空闲连接数。
FILE_WORKSHOP_REDIS_POOL_SIZE=10
FILE_WORKSHOP_REDIS_MIN_IDLE_CONNS=1
FILE_WORKSHOP_REDIS_MAX_IDLE_CONNS=5

# 获取连接等待时间、连接最大空闲时间和最长生命周期。
FILE_WORKSHOP_REDIS_POOL_TIMEOUT=4s
FILE_WORKSHOP_REDIS_CONN_MAX_IDLE_TIME=30m
FILE_WORKSHOP_REDIS_CONN_MAX_LIFETIME=1h
